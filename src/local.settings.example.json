    "GROUP_TAG_VALIDATION_PATTERN": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "PILOT_SERIAL_NUMBERS": "SERIAL001",
    "GRAPH_API_VERSION": "v1.0",
    "MAX_RETRY_COUNT": "4",
    "RETRY_BASE_DELAY_SECONDS": "2",
    "GRAPH_REQUEST_TIMEOUT_SECONDS": "100",
    "LOG_LEVEL": "Information"
  }
}
