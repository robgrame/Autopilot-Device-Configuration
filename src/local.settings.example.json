{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "powershell",
    "TIMER_SCHEDULE": "0 0 */6 * * *",
    "DRY_RUN": "true",
    "INVENTORY_PROVIDER": "package-json",
